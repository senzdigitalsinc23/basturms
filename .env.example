APP_NAME="Your App Name"
SCHOOL="Your School Name"
APP_URL="http://localhost:8000"
APP_ENV=development
APP_DEBUG=true
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60
CORS_ALLOWED_ORIGINS="http://localhost:8000,http://localhost:9002,http://127.0.0.1:9002"
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here

DB_HOST=127.0.0.1
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASS=your_db_password
DB_DRIVER=mysql

# Email Service configuration  
MAIL_HOST=smtp.example.com
MAIL_USER=your_email@example.com
MAIL_PASS="your_email_password"
MAIL_FROM=your_email@example.com
MAIL_NAME="Your Email Sender Name"
MAIL_PORT=465
MAIL_ENCRYPTION=ssl

#SMS Service Configuration
SMS_ID=your_sms_id
TOKEN=your_sms_token
SMS_FROM=+233000000000

JWT_SECRET=your_jwt_secret

# MoMo Sandbox Keys MTN
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com/collection/v1_0
MOMO_PRIMARY_KEY=your_momo_primary_key
MOMO_USER_ID=your_momo_user_id
MOMO_CALLBACK_URL=http://127.0.0.1/webhook/momo
MOMO_CURRENCY=GHS

# HUBTEL (Vodafone & AirtelTigo)
HUBTEL_BASE_URL=https://payproxyapi.hubtel.com
HUBTEL_CLIENT_ID=your_hubtel_client_id
HUBTEL_CLIENT_SECRET=your_hubtel_client_secret
HUBTEL_CALLBACK_URL=https://yourdomain.com/webhook/hubtel

# PAYSTACK (Optional Ghana MoMo support)
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_SECRET_KEY=your_paystack_secret_key
PAYSTACK_CALLBACK_URL=https://yourdomain.com/webhook/paystack
